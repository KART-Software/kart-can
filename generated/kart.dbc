CM_ BU_ data_logger "センサ送信 (ESP32-S3)。BMI160 IMU + ADS8688 ADC + u-blox GNSS。加えて drive-controller への制御信号 (0x740〜) を送信。";
CM_ BU_ drive_controller "駆動系ECU (Teensy 4.1)。ETC/オートシフタ/ローンチ制御。IMU+ギアを送信。";
CM_ BU_ motec_ecu "[外部ノード] MoTeC エンジンECU（外部）。エンジンデータを送信、kart-machine-manager が受信。";
CM_ SG_ 1521 lambda_ "表示側は未デコード";
CM_ SG_ 1522 manifold_pressure "表示側は未デコード";
CM_ SG_ 1523 output_rpm "表示側未デコード";
CM_ SG_ 1523 input_rpm "表示側未デコード";
CM_ SG_ 1523 ist_shift_status "(istUp,istDown): 0=なし,1=DOWN,2=UP,3=両方。表示側未デコード";
CM_ SG_ 1523 fan_enabled "表示側は下位バイト(data[1])をbool化";
CM_ BO_ 1524 "表示デコードなし・UDP転送のみ";
CM_ SG_ 1537 gear "0xFF=不明, 0=N, 1-6=段";
CM_ BO_ 1538 "単位要確認: ヘッダはm/s²だが実データはmg（can-spec.md 注意点4）";
CM_ BO_ 1792 "data-logger 生バッファ byte 0-7（再構成の一部）";
CM_ SG_ 1792 dl_gyro_x "±250dps ≒131.2 LSB/(°/s)";
CM_ SG_ 1792 dl_accel_x "±2g ≒16384 LSB/g";
CM_ BO_ 1793 "data-logger 生バッファ byte 8-15（再構成の一部）";
CM_ SG_ 1793 dl_gyro_z "⚠firmwareバグ: 現状gyro_xを重複送信";
CM_ SG_ 1793 dl_gyro_y "⚠firmwareバグ: 現状gyro_xを重複送信 (bmi160.cpp:70-73)";
CM_ BO_ 1794 "data-logger 生バッファ byte 16-23（再構成の一部）";
CM_ BO_ 1795 "data-logger 生バッファ byte 24-31（再構成の一部）";
CM_ BO_ 1796 "data-logger 生バッファ byte 32-39（再構成の一部）";
CM_ SG_ 1796 gps_valid "bitfield: b0 validDate,b1 validTime,b2 fullyResolved,b3 validMag";
CM_ BO_ 1797 "data-logger 生バッファ byte 40-47（再構成の一部）";
CM_ BO_ 1798 "data-logger 生バッファ byte 48-55（再構成の一部）";
CM_ SG_ 1798 gps_num_sv "使用衛星数";
CM_ SG_ 1798 gps_flags "b0 gnssFixOK 他";
CM_ SG_ 1798 gps_fix_type "0=nofix,2=2D,3=3D,4=GNSS+DR,5=time";
CM_ BO_ 1799 "data-logger 生バッファ byte 56-63（再構成の一部）";
CM_ BO_ 1800 "data-logger 生バッファ byte 64-71（再構成の一部）";
CM_ BO_ 1801 "data-logger 生バッファ byte 72-79（再構成の一部）";
CM_ BO_ 1802 "data-logger 生バッファ byte 80-87（再構成の一部）";
CM_ BO_ 1803 "data-logger 生バッファ byte 88-95（再構成の一部）";
CM_ BO_ 1804 "data-logger 生バッファ byte 96-103（再構成の一部）";
CM_ BO_ 1805 "data-logger 生バッファ byte 104-111（再構成の一部）";
CM_ SG_ 1805 gps_flags3 "b0 invalidLlh";
CM_ BO_ 1806 "data-logger 生バッファ byte 112-119（再構成の一部）";
CM_ BO_ 1856 "制御信号フレーム (制御ID帯 0x740〜の先頭)。byte0=ETCモード, byte1=launch, byte2=auto-shift。200ms途絶でフェイルセーフ。";
CM_ SG_ 1856 auto_shift "0x01=オート(ON)、その他=マニュアル(OFF)。200ms途絶→manual";
CM_ SG_ 1856 launch_active "0x01=active、その他=inactive。200ms途絶→inactive。通常ビルドではFSM無効";
CM_ SG_ 1856 etc_mode "0=未指定(無視・現モード維持)。200ms途絶→NORMAL(MOTOR_OFFはラッチ)";
