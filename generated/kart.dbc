CM_ BU_ data_logger "kmm M コア (Cortex-M4, data-logger-zephyr apps/can-gw)。ADS8688 ADC とコックピットスイッチを送信。Linux 向け CAN ゲートウェイ。";
CM_ BU_ drive_controller "駆動系ECU (Teensy 4.1, 車両後方)。ETC/クラッチ/シフト/セルモーター/ブレーキランプ制御。IMU・APPS/TPS・後方センサー・車輪速・自身の状態を送信。";
CM_ BU_ kart_machine_manager "kmm A コア (Linux)。M コアのゲートウェイ経由で CAN 全受信。インパネ表示・ログ・クラウド送信。実バスへ送信しない。";
CM_ BU_ motec_ecu "[外部ノード] MoTeC M800 エンジンECU（外部）。エンジンデータを送信。";
CM_ BO_ 1521 "battery_voltage は drive_controller が Vbat として使用";
CM_ SG_ 1523 ist_shift_status "(istUp,istDown): 0=なし,1=DOWN,2=UP,3=両方";
CM_ BO_ 1536 "IMU (IAM-20680HP) ジャイロ X/Y";
CM_ BO_ 1537 "IMU ジャイロ Z + ギア位置";
CM_ SG_ 1537 gear "0xFF=不明, 0=N, 1-6=段";
CM_ BO_ 1538 "IMU 加速度 X/Y (単位要確認: 旧実装は mg)";
CM_ BO_ 1539 "IMU 加速度 Z";
CM_ BO_ 1540 "ペダル・スロットル・クラッチ・後ろブレーキ圧 (drive_controller が算出した物理値)";
CM_ SG_ 1540 brake_press_rear "後ろブレーキ圧";
CM_ SG_ 1540 clutch "クラッチ位置";
CM_ SG_ 1540 tps "スロットル開度 (TPS 2 系統から算出)";
CM_ SG_ 1540 apps "採用したアクセルペダル開度 (APPS 2 系統から算出)";
CM_ BO_ 1541 "APPS / TPS 各 2 系統の生値 (drive_controller の ADS8688 カウント)";
CM_ BO_ 1542 "後ろ左右サスペンションストローク (センサー電圧)";
CM_ BO_ 1543 "車輪速 4 輪";
CM_ BO_ 1544 "車輪速パルスの生カウント 4 輪 (累積、uint16 でラップ)";
CM_ BO_ 1545 "エンジン回転数 (drive_controller のパルス計測値)";
CM_ SG_ 1545 clutch_rpm "クラッチ後 (出力軸) 回転数";
CM_ BO_ 1546 "drive_controller が適用中の制御状態とリレー状態";
CM_ SG_ 1546 shutdown_loop "Shutdown Circuit (AND 回路) の出力状態";
CM_ SG_ 1546 starter_relay "セルモーターリレー出力";
CM_ SG_ 1546 etc_mode "適用中の ETC モード";
CM_ BO_ 1792 "data-logger 生バッファ byte 0-7（再構成の一部）";
CM_ BO_ 1793 "data-logger 生バッファ byte 8-15（再構成の一部）";
CM_ BO_ 1856 "コックピットスイッチ状態 (ETC モード / ローンチ / オートシフト / セル)";
CM_ SG_ 1856 starter "セルスイッチ。押下中 1";
CM_ SG_ 1856 auto_shift "オートシフト ON/OFF スイッチ";
CM_ SG_ 1856 launch_active "ローンチコントロール ON/OFF スイッチ";
CM_ SG_ 1856 etc_mode "ETC モード選択スイッチ。0=未指定";
CM_ BO_ 1857 "シフトパドル状態";
CM_ SG_ 1857 shift_down "シフトダウンパドル。押下中 1";
CM_ SG_ 1857 shift_up "シフトアップパドル。押下中 1";
